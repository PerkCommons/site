# Public build-time browser values.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_SITE_URL=

# Public browser credentials. Row Level Security must remain enabled.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared server runtime values. Never commit real secret values.
SUPABASE_PUBLISHABLE_KEY=
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUBMISSION_FINGERPRINT_SECRET=
GITHUB_DATA_PUBLICATION_TOKEN=
GITHUB_SITE_DEPLOY_TOKEN=

# Canonical Vercel build/runtime configuration.
PERKCOMMONS_DATA_REPOSITORY=https://github.com/PerkCommons/data.git
# Pin this to the exact verified data SHA for release-candidate deployments.
PERKCOMMONS_DATA_REF=
GITHUB_DATA_REPOSITORY=PerkCommons/data
GITHUB_DATA_BRANCH=main
GITHUB_HEAD_OWNER=PerkCommons
GITHUB_SITE_REPOSITORY=PerkCommons/site
FORK_ONLY_MODE=false
CRON_SECRET=
