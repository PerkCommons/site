---
import { Github, Menu, Moon, ShieldCheck, Sun, X } from "lucide-astro";
import { baseStructuredData, canonicalUrl, safeJsonLd } from "../lib/seo";
import "../styles/global.css";

interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = canonicalUrl(Astro.site!, Astro.url.pathname);
const socialImage = new URL("/brand/social-card.png", Astro.site!);
const structuredData = baseStructuredData(Astro.site!);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta name="theme-color" content="#FAFBFC" />
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("perkcommons-theme");
        } catch {}
        const theme = saved === "dark" || saved === "light"
          ? saved
          : matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#0D1117" : "#FAFBFC");
      })();
    </script>
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="PerkCommons" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={safeJsonLd(structuredData)} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-surface focus:px-4 focus:py-3">Skip to content</a>
    <header class="border-b border-line bg-surface">
      <div class="container flex min-h-16 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="PerkCommons home">
          <img src="/brand/mark.svg" width="32" height="32" alt="" />
          <span class="text-base font-semibold text-ink">PerkCommons</span>
        </a>
        <nav class="hidden items-center gap-7 text-sm font-medium text-muted md:flex" aria-label="Primary navigation">
          <a href="/opportunities/" class="hover:text-ink">Browse</a>
          <a href="/categories/" class="hover:text-ink">Categories</a>
          <a href="/about/" class="hover:text-ink">How it works</a>
          <a href="/trust/" class="hover:text-ink">Trust</a>
          <a href="https://github.com/PerkCommons/data" class="hover:text-ink">Open data</a>
          <a href="https://github.com/PerkCommons/site" class="inline-flex items-center gap-1.5 hover:text-ink"><Github size={16} /> Source</a>
          <a href="/submit/" class="rounded-md bg-action px-4 py-2.5 text-white hover:bg-action-hover">Submit an opportunity</a>
        </nav>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme"><Moon class="theme-icon theme-icon-moon" size={20} aria-hidden="true" /><Sun class="theme-icon theme-icon-sun" size={20} aria-hidden="true" /></button>
        <button id="menu-button" class="grid size-10 place-items-center rounded-md border border-line md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><Menu id="menu-open" size={20} /><X id="menu-close" class="hidden" size={20} /></button>
      </div>
      <nav id="mobile-menu" class="container hidden border-t border-line py-3 md:hidden" aria-label="Mobile navigation">
        <a class="block py-3" href="/opportunities/">Browse</a><a class="block py-3" href="/categories/">Categories</a><a class="block py-3" href="/about/">How it works</a><a class="block py-3" href="/trust/">Trust</a><a class="block py-3" href="https://github.com/PerkCommons/data">Open data</a><a class="block py-3" href="/submit/">Submit an opportunity</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="mt-20 border-t border-line bg-surface py-12 text-sm text-muted">
      <div class="container grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.4fr_.8fr_.9fr_1.3fr]">
        <div>
          <p class="font-semibold text-ink">PerkCommons</p>
          <p class="mt-2 max-w-md leading-6">An open, community-maintained index of credible opportunities. Free to browse and reuse.</p>
          <a
            href="https://www.scamadviser.com/check-website/perkcommons.com"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex flex-col items-start gap-2 text-xs no-underline hover:underline"
            aria-label="View PerkCommons on ScamAdviser"
          >
            <img
              src="/scamadviser-logo.jpg"
              width="160"
              height="50"
              alt="ScamAdviser"
              loading="lazy"
              decoding="async"
              class="rounded-sm border border-line bg-white p-1"
            />
            <span>View our ScamAdviser listing</span>
          </a>
        </div>
        <div><p class="font-semibold text-ink">Project</p><a class="mt-3 block" href="/about/">About</a><a class="mt-2 block" href="/trust/">Trust and transparency</a><a class="mt-2 block" href="/data-quality/">Data quality</a><a class="mt-2 block" href="https://github.com/CodWasTaken/docs">Policies</a><a class="mt-2 block" href="https://github.com/PerkCommons/data">Open dataset</a></div>
        <div><p class="font-semibold text-ink">Participate</p><a class="mt-3 block" href="/submit/">Submit</a><a class="mt-2 block" href="https://github.com/PerkCommons/data/issues">Report a correction</a><a class="mt-2 inline-flex min-h-11 items-center gap-1.5" href="/moderator-login/"><ShieldCheck size={15} aria-hidden="true" /> Moderator sign in</a></div>
        <div aria-label="Contact">
          <p class="font-semibold text-ink">Contact</p>
          <a class="mt-3 block" href="mailto:hello@perkcommons.com">General</a>
          <a class="mt-2 block" href="mailto:support@perkcommons.com">Support</a>
          <a class="mt-2 block" href="mailto:security@perkcommons.com">Security</a>
          <a class="mt-2 block" href="mailto:privacy@perkcommons.com">Privacy</a>
          <a class="mt-2 block" href="mailto:press@perkcommons.com">Press</a>
        </div>
      </div>
        {!noindex && (
        <section id="site-activity-stats" class="container mt-10 border-t border-line pt-6" aria-label="Public site activity">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-sm font-semibold text-ink">PerkCommons activity</p>
              <p class="mt-1 text-xs">First-party, approximate counts from when tracking began.</p>
            </div>
            <dl class="grid grid-cols-3 gap-5 sm:gap-8">
              <div>
                <dt class="text-xs">Browsers this month</dt>
                <dd data-stat="monthlyBrowsers" class="mt-1 text-xl font-semibold tabular-nums text-ink">—</dd>
              </div>
              <div>
                <dt class="text-xs">Active now</dt>
                <dd data-stat="onlineNow" class="mt-1 text-xl font-semibold tabular-nums text-ink">—</dd>
              </div>
              <div>
                <dt class="text-xs">Listings opened</dt>
                <dd data-stat="listingOpens" class="mt-1 text-xl font-semibold tabular-nums text-ink">—</dd>
              </div>
            </dl>
          </div>
          <p data-analytics-counting-status class="mt-4 text-xs font-medium text-muted" aria-live="polite">Checking this browser’s optional analytics preference…</p>
          <p class="mt-2 text-xs leading-5">Monthly visitors are unique consenting browsers, not visits. Opening this website repeatedly on the same browser adds only one. Browsers with Do Not Track or Global Privacy Control enabled are not counted. Active now covers the past five minutes.</p>
          <p class="mt-2 text-xs leading-5">Monthly count for <span data-stat-month>this month (UTC)</span>. “Active” means a browser seen within five minutes. Listing opens are counted at most once per browser and listing every 30 minutes. <a href="/privacy/" class="underline">Privacy details</a>. <button type="button" data-open-analytics-settings class="ml-2 underline">Analytics choices</button>.</p>
        </section>
      )}
    </footer>
    {!noindex && (
      <aside id="analytics-consent-banner" aria-label="Optional analytics consent" class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-line bg-surface p-4 shadow-xl sm:p-6">
        <div class="container flex max-w-5xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="max-w-2xl">
            <p class="font-semibold text-ink">Optional PerkCommons analytics</p>
            <p class="mt-1 text-sm leading-6 text-muted">With your permission, we store a monthly browser identifier to count visitors active now, monthly browsers and opportunity opens. No advertising or third-party analytics. Rejecting won't change the site. <a href="/privacy/" class="underline">Details and privacy rights</a>.</p>
            <p id="analytics-consent-state" aria-live="polite" class="mt-1 text-xs text-muted"></p>
          </div>
          <div class="flex shrink-0 flex-wrap gap-3">
            <button data-analytics-reject type="button" class="min-h-11 rounded-md border border-line bg-surface px-4 font-semibold text-ink">Reject optional analytics</button>
            <button data-analytics-accept type="button" class="min-h-11 rounded-md border border-line bg-surface px-4 font-semibold text-ink">Accept optional analytics</button>
          </div>
        </div>
      </aside>
    )}
    <script>
      import "../scripts/site-stats";
      const button = document.querySelector<HTMLButtonElement>("#menu-button");
      const menu = document.querySelector<HTMLElement>("#mobile-menu");
      button?.addEventListener("click", () => {
        const open = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!open));
        button.setAttribute("aria-label", open ? "Open menu" : "Close menu");
        menu?.classList.toggle("hidden", open);
        document.querySelector("#menu-open")?.classList.toggle("hidden", !open);
        document.querySelector("#menu-close")?.classList.toggle("hidden", open);
      });

      const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
      const root = document.documentElement;
      const colorScheme = matchMedia("(prefers-color-scheme: dark)");
      const updateThemeControl = () => {
        const dark = root.dataset.theme === "dark";
        const label = dark ? "Switch to light mode" : "Switch to dark mode";
        themeToggle?.setAttribute("aria-label", label);
        themeToggle?.setAttribute("title", label);
        themeToggle?.setAttribute("aria-pressed", String(dark));
        document
          .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
          ?.setAttribute("content", dark ? "#0D1117" : "#FAFBFC");
      };
      const applyTheme = (theme: "light" | "dark", persist: boolean) => {
        root.classList.add("theme-transitioning");
        root.dataset.theme = theme;
        if (persist) {
          try {
            localStorage.setItem("perkcommons-theme", theme);
          } catch {}
        }
        updateThemeControl();
        window.setTimeout(
          () => root.classList.remove("theme-transitioning"),
          280,
        );
      };

      updateThemeControl();
      themeToggle?.addEventListener("click", () => {
        applyTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
      });
      colorScheme.addEventListener("change", (event) => {
        let saved = null;
        try {
          saved = localStorage.getItem("perkcommons-theme");
        } catch {}
        if (!saved)
          applyTheme(event.matches ? "dark" : "light", false);
      });

      const listingNodes = [
        ...document.querySelectorAll<HTMLElement>("[data-listing-id]"),
      ];
      if (listingNodes.length) {
        const listingIds = [
          ...new Set(
            listingNodes
              .map((node) => node.dataset.listingId)
              .filter((id): id is string => Boolean(id)),
          ),
        ];
        const batches = Array.from(
          { length: Math.ceil(listingIds.length / 100) },
          (_, index) => listingIds.slice(index * 100, index * 100 + 100),
        );
        void Promise.all(batches.map(async (batch) => {
          const query = new URLSearchParams();
          batch.forEach((id) => query.append("id", id));
          const response = await fetch(`/api/listings/state?${query}`);
          if (!response.ok) return [];
          const payload = (await response.json()) as {
              listings?: Array<{
                listing_id: string;
                featured: boolean;
                removed: boolean;
              }>;
            };
          return payload.listings ?? [];
        }))
          .then(async (responses) => {
            const states = new Map(
              responses.flat().map((item) => [item.listing_id, item]),
            );
            listingNodes.forEach((node) => {
              const id = node.dataset.listingId;
              if (!id) return;
              const state = states.get(id);
              if (state?.removed) {
                if (node.hasAttribute("data-listing-detail")) {
                  node.replaceChildren();
                  const notice = document.createElement("section");
                  notice.className = "py-16 text-center";
                  const heading = document.createElement("h1");
                  heading.className = "text-3xl font-semibold";
                  heading.textContent = "Listing removed";
                  const detail = document.createElement("p");
                  detail.className = "mt-3 text-muted";
                  detail.textContent =
                    "This opportunity was removed after moderator review.";
                  const back = document.createElement("a");
                  back.href = "/opportunities/";
                  back.className = "mt-6 inline-flex font-medium";
                  back.textContent = "Browse other opportunities";
                  notice.append(heading, detail, back);
                  node.append(notice);
                } else node.hidden = true;
              }
              document
                .querySelectorAll<HTMLElement>(`[data-feature-star="${CSS.escape(id)}"]`)
                .forEach((star) => star.classList.toggle("hidden", !state?.featured));
            });

            const toggle = document.querySelector<HTMLButtonElement>(
              "[data-feature-toggle]",
            );
            if (!toggle?.dataset.featureToggle) return;
            const auth = await fetch("/api/auth/me");
            if (!auth.ok) return;
            const authState = (await auth.json()) as { moderator?: unknown };
            if (!authState.moderator) return;
            document
              .querySelectorAll<HTMLElement>("[data-moderator-tools]")
              .forEach((tools) => {
                tools.hidden = false;
                tools.classList.remove("hidden");
              });
            const id = toggle.dataset.featureToggle;
            let featured = states.get(id)?.featured ?? false;
            const featureStatus = document.querySelector<HTMLElement>(
              "[data-feature-status]",
            );
            const updateToggle = () => {
              toggle.setAttribute("aria-pressed", String(featured));
              toggle.querySelector("span")!.textContent = featured
                ? "Remove featured status"
                : "Feature opportunity";
              toggle.classList.remove("hidden");
              toggle.classList.add("inline-flex");
            };
            updateToggle();
            toggle.addEventListener("click", async () => {
              toggle.disabled = true;
              try {
                const response = await fetch(
                  `/api/moderation/listings/${encodeURIComponent(id)}/feature`,
                  {
                    method: "POST",
                    headers: { "content-type": "application/json" },
                    body: JSON.stringify({ featured: !featured }),
                  },
                );
                if (!response.ok) {
                  if (featureStatus)
                    featureStatus.textContent = "Featured status could not be updated.";
                  return;
                }
                featured = !featured;
                document
                  .querySelectorAll<HTMLElement>(`[data-feature-star="${CSS.escape(id)}"]`)
                  .forEach((star) => star.classList.toggle("hidden", !featured));
                updateToggle();
                if (featureStatus)
                  featureStatus.textContent = featured
                    ? "Opportunity marked as featured."
                    : "Featured status removed.";
              } finally {
                toggle.disabled = false;
              }
            });
          })
          .catch(() => undefined);
      }
    </script>
  </body>
</html>