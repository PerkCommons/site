---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDataRepositoryRoot } from "../lib/data-path";
import { getListings, statusLabel, type ListingStatus } from "../lib/listings";

interface CountMetric {
  count: number;
  percentage: number;
}

interface UnmeasuredMetric {
  status: "not-measured";
  reason: string;
}

interface MeasuredNetworkMetric {
  status: "measured";
  count: number;
  inspected: number;
  percentage: number;
  asOf: string;
}

type NetworkMetric = UnmeasuredMetric | MeasuredNetworkMetric;

interface DataQualityReport {
  reportVersion: number;
  asOf: string;
  recordsInspected: number;
  metrics: {
    defaultSearchEligible: CountMetric;
    explicitlyExcludedFromDefault: CountMetric;
    structuredDeadlines: CountMetric;
    applicationUrls: CountMetric;
    providerSpecificEligibility: CountMetric;
    multipleEvidenceLinks: CountMetric;
    duplicateUrlRecords: CountMetric;
    genericTextRecords: CountMetric;
    brokenLinkRate: NetworkMetric;
    redirectRate: NetworkMetric;
    uncertainStatus: CountMetric;
    incompleteGeography: CountMetric;
    humanReviewProvenance: CountMetric;
    requiresManualSourceReview: CountMetric;
  };
  interpretation: string;
}

const dataRoot = await getDataRepositoryRoot();
const report = JSON.parse(
  await readFile(resolve(dataRoot, "reports/data-quality.json"), "utf8"),
) as DataQualityReport;
const listings = await getListings();
const statusCounts = Object.entries(
  listings.reduce<Record<string, number>>((counts, listing) => {
    counts[listing.status] = (counts[listing.status] ?? 0) + 1;
    return counts;
  }, {}),
).sort(([a], [b]) => a.localeCompare(b));

const countMetrics = [
  ["Default-search eligible", report.metrics.defaultSearchEligible],
  ["Excluded from default search", report.metrics.explicitlyExcludedFromDefault],
  ["Human-review provenance", report.metrics.humanReviewProvenance],
  ["Requires manual source review", report.metrics.requiresManualSourceReview],
  ["Structured deadlines", report.metrics.structuredDeadlines],
  ["Application URLs", report.metrics.applicationUrls],
  ["Provider-specific eligibility", report.metrics.providerSpecificEligibility],
  ["Multiple evidence links", report.metrics.multipleEvidenceLinks],
  ["Incomplete geography", report.metrics.incompleteGeography],
  ["Uncertain availability status", report.metrics.uncertainStatus],
  ["Duplicate-URL candidates", report.metrics.duplicateUrlRecords],
  ["Generic-text records", report.metrics.genericTextRecords],
] as const;

const formatReportDate = (value: string) =>
  new Intl.DateTimeFormat("en", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${value}T00:00:00Z`));

const networkMetricValue = (metric: NetworkMetric) =>
  metric.status === "measured"
    ? `${metric.percentage.toFixed(2)}%`
    : "Not measured";

const networkMetricDetail = (metric: NetworkMetric) =>
  metric.status === "measured"
    ? `${metric.count.toLocaleString("en")} of ${metric.inspected.toLocaleString("en")} URLs inspected · audit ${formatReportDate(metric.asOf)}`
    : metric.reason;
---

<BaseLayout
  title="Data quality and methodology — PerkCommons"
  description="Current PerkCommons catalogue quality metrics, human-review coverage, availability states, provenance gaps, and measurement limits."
>
  <section class="container py-14">
    <p class="text-sm font-semibold text-brand">Data quality</p>
    <h1 class="mt-2 max-w-3xl text-4xl font-semibold">
      The catalogue's gaps are part of the public record.
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">
      These metrics come from the version-controlled data-quality report in
      the public dataset. They describe coverage; they are not a score, a
      guarantee, or a substitute for provider terms.
    </p>

    <div class="mt-8 flex flex-wrap gap-x-8 gap-y-2 text-sm text-muted">
      <p><strong class="text-ink">Report date:</strong> {formatReportDate(report.asOf)}</p>
      <p><strong class="text-ink">Records inspected:</strong> {report.recordsInspected.toLocaleString("en")}</p>
      <p><strong class="text-ink">Report version:</strong> {report.reportVersion}</p>
    </div>

    <section class="mt-12" aria-labelledby="coverage-heading">
      <h2 id="coverage-heading" class="text-2xl font-semibold">Coverage and provenance</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {countMetrics.map(([label, metric]) => (
          <article class="rounded-md border border-line bg-surface p-5">
            <p class="text-sm text-muted">{label}</p>
            <p class="mt-2 text-3xl font-semibold">{metric.count.toLocaleString("en")}</p>
            <p class="mt-1 text-sm text-muted">{metric.percentage.toFixed(2)}% of inspected records</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-10" aria-labelledby="availability-heading">
      <h2 id="availability-heading" class="text-2xl font-semibold">Availability states in this build</h2>
      <p class="mt-3 max-w-3xl leading-7 text-muted">
        These counts are calculated from the exact dataset used to build this
        site. “Unconfirmed” means the current access state could not be
        established confidently; it does not mean a program is open.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[420px] border-collapse text-left text-sm">
          <thead><tr class="border-b border-line"><th class="py-3 pr-6 font-semibold">Status</th><th class="py-3 font-semibold">Records</th></tr></thead>
          <tbody>
            {statusCounts.map(([status, count]) => (
              <tr class="border-b border-line">
                <td class="py-3 pr-6">{statusLabel(status as ListingStatus)}</td>
                <td class="py-3">{count.toLocaleString("en")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-10" aria-labelledby="network-heading">
      <h2 id="network-heading" class="text-2xl font-semibold">Network audit coverage</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <article class="rounded-md border border-line bg-surface p-5">
          <p class="text-sm text-muted">Broken-link rate</p>
          <p class="mt-2 text-xl font-semibold">{networkMetricValue(report.metrics.brokenLinkRate)}</p>
          <p class="mt-2 text-sm leading-6 text-muted">{networkMetricDetail(report.metrics.brokenLinkRate)}</p>
        </article>
        <article class="rounded-md border border-line bg-surface p-5">
          <p class="text-sm text-muted">Redirect rate</p>
          <p class="mt-2 text-xl font-semibold">{networkMetricValue(report.metrics.redirectRate)}</p>
          <p class="mt-2 text-sm leading-6 text-muted">{networkMetricDetail(report.metrics.redirectRate)}</p>
        </article>
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-10">
      <h2 class="text-2xl font-semibold">How to read these numbers</h2>
      <div class="mt-4 max-w-3xl space-y-4 leading-7 text-muted">
        <p>{report.interpretation}</p>
        <p>
          Automated source research is not human review. A record can have a
          recent source fetch while still requiring a moderator to verify the
          claims presented to users.
        </p>
        <p>
          Scope heuristics and duplicate candidates are review aids. They do
          not automatically publish, remove, merge, archive, or reclassify a
          record.
        </p>
      </div>
      <div class="mt-6 flex flex-wrap gap-4 text-sm font-medium">
        <a href="/about/">Review methodology</a>
        <a href="/trust/">Trust and transparency</a>
        <a href="https://github.com/PerkCommons/data/tree/main/reports" rel="noopener">Inspect public quality reports</a>
      </div>
    </section>
  </section>
</BaseLayout>