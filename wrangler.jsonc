{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perkcommons-site",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "vars": {
    "ENVIRONMENT": "production",
    "GITHUB_DATA_REPOSITORY": "PerkCommons/data",
    "GITHUB_DATA_BRANCH": "main",
    "GITHUB_HEAD_OWNER": "PerkCommons",
    "GITHUB_SITE_REPOSITORY": "PerkCommons/site",
    "FORK_ONLY_MODE": "false"
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/moderate",
      "/moderate/*",
      "/opportunities/*"
    ]
  },
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "TRACKING_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "dev": {
      "name": "perkcommons-site-dev",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "ENVIRONMENT": "test",
        "GITHUB_DATA_REPOSITORY": "PerkCommons/data",
        "GITHUB_DATA_BRANCH": "main",
        "GITHUB_HEAD_OWNER": "PerkCommons",
        "GITHUB_SITE_REPOSITORY": "PerkCommons/site",
        "FORK_ONLY_MODE": "false"
      },
      "secrets": {
        "required": [
          "SUPABASE_URL",
          "SUPABASE_PUBLISHABLE_KEY",
          "SUPABASE_SERVICE_ROLE_KEY",
          "SUBMISSION_FINGERPRINT_SECRET"
        ]
      },
      "triggers": {
        "crons": []
      },
      "ratelimits": [
        {
          "name": "SUBMISSION_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "REPORT_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "LOGIN_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "TRACKING_RATE_LIMITER",
          "namespace_id": "2004",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
    }
  }
}
